---
source: crates/hecaton-config/tests/resolve_golden.rs
expression: spec
---
name: payments
crews:
  backend:
    repo: acme/payments-api
    ref: main
    git:
      push: true
      auth: gh
    agents:
      alice:
        claude:
          settings:
            model: sonnet
            permissions:
              allow:
                - Bash(git *)
            theme: dark
          args:
            - "--verbose"
          resume: true
          binary: claude
        sandbox:
          network:
            mode: allow
        tools:
          node: 22.11.0
          python: 3.12.8
        env:
          RUST_LOG: info
        runner:
          type: tmux
        flow: {}
      bob:
        claude:
          settings:
            model: opus
            permissions:
              allow:
                - Bash(git *)
            theme: dark
          args:
            - "--verbose"
          resume: true
          binary: claude
        sandbox:
          network:
            mode: allow
        tools:
          node: 22.11.0
          python: 3.12.8
        env:
          RUST_LOG: info
        runner:
          type: tmux
        flow: {}
