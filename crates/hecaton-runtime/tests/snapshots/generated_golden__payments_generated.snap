==== payments/backend/alice launch.sh ====
#!/bin/sh
# generated by hecaton — safe to run by hand
exec env -i HOME='<root>/state/fleets/payments/crews/backend/agents/alice/nono' PATH='/usr/local/bin:/usr/bin:/bin:/tools' \
  '/tools/nono' '-s' '--log-file' '<root>/state/fleets/payments/crews/backend/agents/alice/logs/nono.log' 'run' '--profile' '<root>/state/fleets/payments/crews/backend/agents/alice/nono-profile.json' '--' '/tools/mise' 'exec' '--' 'claude' '--verbose'

